# Layer-efficiency thresholds for the review gate, applied to every built image.
#
# Baseline calibrated 2026-08-11 against the images this repository produces, which measured between
# 96.6% and 99.4% efficient with 0.6 MB to 12 MB wasted. The floor values sit just below the least
# efficient target, so a gross regression (an unpruned build dependency, a forgotten cache) fails
# while the known, deliberate waste passes. A change that widens waste beyond these bounds is a
# signal to prune the RUN, not to loosen a threshold.
rules:
  # Fail when the image efficiency (unique bytes over total bytes) drops below this fraction.
  lowestEfficiency: 0.95

  # Fail when the total wasted space meets or exceeds this size.
  highestWastedBytes: 20MB

  # Fail when wasted space meets or exceeds this fraction of the bytes the build itself added.
  highestUserWastedPercent: 0.10
