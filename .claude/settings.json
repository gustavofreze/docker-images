{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "args": ["-B", "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-markdown-layout.py"],
                        "command": "python3",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
