#!/usr/bin/env bash
set -euo pipefail

# phpmd: Runs the pinned PHP Mess Detector phar with deprecation notices silenced.
#
# PHPMD 2.15.0 is the newest release and predates PHP 8.4, so loading its own phar raises a wall of
# deprecation notices unrelated to the code under analysis. Silencing them here affects this process
# only, and the analyzer still reports every rule violation it finds.
#
# Usage: phpmd <arguments passed through to PHP Mess Detector>

readonly PHAR_PATH="/usr/local/lib/phpmd.phar"

main() {
    exec php -d error_reporting="E_ALL & ~E_DEPRECATED" "${PHAR_PATH}" "$@"
}

main "$@"
