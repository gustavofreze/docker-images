# Normalize line endings. Every text file is stored and checked out as LF.
* text=auto eol=lf

# Force LF on assets executed or parsed inside Linux containers.
# CRLF here would break shell scripts and config parsers at runtime.
*.sh           text eol=lf
**/scripts/*   text eol=lf
**/bin/*       text eol=lf
Dockerfile     text eol=lf
Makefile       text eol=lf
*.conf         text eol=lf
*.ini          text eol=lf

# Markdown diff driver, and keep prose out of the GitHub language breakdown.
*.md          diff=markdown linguist-documentation

# Point the language breakdown at what this repository publishes, which is images. The Makefile and
# the shell under scripts/ and bin/ are the verification gate and the baked helpers, not the product,
# and the phpmd wrapper is a shim that would otherwise report this as a PHP project.
Makefile       linguist-detectable=false
*.sh           linguist-detectable=false
**/scripts/*   linguist-detectable=false
**/bin/*       linguist-detectable=false
