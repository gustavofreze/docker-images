# Normalize line endings. Every text file is stored and checked out as LF.
* text=auto eol=lf

# Force LF on assets executed or parsed inside Linux containers.
# CRLF here would break shell scripts and config parsers at runtime.
*.sh           text eol=lf
**/scripts/*   text eol=lf
**/bin/*       text eol=lf
Dockerfile     text eol=lf
Makefile       text eol=lf
*.conf         text eol=lf
*.ini          text eol=lf

# Markdown diff driver, and keep prose out of the GitHub language breakdown.
*.md          diff=markdown linguist-documentation

# Point the language breakdown at what this repository publishes, which is images. The Makefile, the
# shell under scripts/ and bin/, and the hooks under .claude/ are the verification gate, the baked
# helpers and the editing tooling, not the product. The phpmd wrapper is a shim that would otherwise
# report this as a PHP project, and the hooks would report it as a Python one.
Makefile       linguist-detectable=false
*.sh           linguist-detectable=false
**/scripts/*   linguist-detectable=false
**/bin/*       linguist-detectable=false
.claude/**     linguist-detectable=false
